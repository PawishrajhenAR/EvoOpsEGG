# EvoOps — copy to .env.local (web) and .env (api/worker). Never commit real values.

# --- Supabase (Auth, Postgres, RLS) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- LLM ---
OPENAI_API_KEY=sk-your_openai_api_key

# --- Email ---
RESEND_API_KEY=re_your_resend_api_key

# --- Observability (Langfuse) ---
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Web (Next.js on Vercel) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=local

# --- API & worker (Railway / Render) ---
API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=local
CORS_ORIGINS=http://localhost:3000

# --- Optional connectors (placeholders) ---
SLACK_BOT_TOKEN=xoxb-your_slack_bot_token
SLACK_SIGNING_SECRET=your_slack_signing_secret

# --- TestSprite / CI (when configured) ---
TESTSPRITE_API_KEY=your_testsprite_api_key
TESTSPRITE_PROJECT_ID=your_testsprite_project_id

# --- Graphify (local dev only; outputs go to graphify-out/, ignored by git) ---
# GRAPHIFY_API_KEY=your_graphify_key_if_applicable
