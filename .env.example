# EvoOps — copy to `.env` (repo root). Never commit real values.
# cp .env.example .env

# --- Supabase (Auth, Postgres, RLS) ---
# Project URL: Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Prefer publishable key (new) or legacy anon JWT key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_jwt_optional
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# If the DB password contains # @ : / ? & etc:
# 1) Quote it: SUPABASE_DB_PASSWORD="MyP@ss#word"
# 2) URL-encode those chars inside DATABASE_URL (@→%40, #→%23)
#    Wrong:  ...://postgres:MyP@ss#word@db...   (# starts a comment; @ breaks the URL)
#    Right:  DATABASE_URL="postgresql://postgres:MyP%40ss%23word@db.YOUR_REF.supabase.co:5432/postgres"
SUPABASE_DB_PASSWORD="YOUR_PASSWORD"
# Prefer pooler on Windows if db.<ref>.supabase.co fails DNS:
# DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# --- LLM ---
OPENAI_API_KEY=sk-your_openai_api_key

# --- Email ---
RESEND_API_KEY=re_your_resend_api_key

# --- Observability (Langfuse) ---
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=local

# --- API & worker ---
API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=local
CORS_ORIGINS=http://localhost:3000

# --- Optional connectors ---
SLACK_BOT_TOKEN=xoxb-your_slack_bot_token
SLACK_SIGNING_SECRET=your_slack_signing_secret

# --- TestSprite / CI ---
TESTSPRITE_API_KEY=your_testsprite_api_key
TESTSPRITE_PROJECT_ID=your_testsprite_project_id
